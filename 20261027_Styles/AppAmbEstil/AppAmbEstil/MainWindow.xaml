<Window x:Class="AppAmbEstil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAmbEstil"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <StackPanel >

            <Button >Primer</Button>
            <Button >Segon</Button>
            <Button>Tercer</Button>
            <Button>Quart</Button>

            <Button Style="{StaticResource PositiveActionButtonStyle}"></Button>
            <Button Style="{StaticResource CustomButtonStyle}">Custom</Button>
            
            <TextBox x:Name="txtPrimer"></TextBox>
            <TextBox x:Name="txtSegon"></TextBox>
            <TextBox x:Name="txtTercer"></TextBox>
            <TextBox Width="200"  x:Name="txtQuart">
            </TextBox>
        </StackPanel>

    </Grid>
</Window>

<Window x:Class="_202060915_TipusVariables.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_202060915_TipusVariables"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded"
        >
    <StackPanel Orientation="Vertical">
        <TextBox x:Name="txtSortida"></TextBox>
        <ComboBox x:Name="cboMesos" HorizontalAlignment="Left"></ComboBox>

        <Label>Idioma:</Label>
        <ComboBox x:Name="cboIdioma" SelectionChanged="cboIdioma_SelectionChanged" Width="100" HorizontalAlignment="Left"></ComboBox>
        
        <Label>Mesos:</Label>
        <ListBox x:Name="lsbMesos"></ListBox>
    
    </StackPanel>
</Window>

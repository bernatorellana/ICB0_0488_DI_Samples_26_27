<Window x:Class="ConversionsFromString.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConversionsFromString"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="25*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="101*"/>
        </Grid.RowDefinitions>

        <Label HorizontalContentAlignment="right"
               Grid.Column="0" Grid.Row="0" >Número:</Label>
        <Label HorizontalContentAlignment="right" Grid.Column="0" Grid.Row="1" >Pes:</Label>
        <Label HorizontalContentAlignment="right" Grid.Column="0" Grid.Row="2"  >Data:</Label>
        <Label HorizontalContentAlignment="right" Grid.Column="0" Grid.Row="3"  >e-mail:</Label>
        <Label HorizontalContentAlignment="right" Grid.Column="0" Grid.Row="4"  >NIF:</Label>

        <TextBox x:Name="txtNumero" TextChanged="txtNumero_TextChanged" Grid.Column="1" Grid.Row="0" ></TextBox>
        <TextBox x:Name="txtPes" TextChanged="txtPes_TextChanged" Grid.Column="1" Grid.Row="1"  ></TextBox>
        <TextBox x:Name="txtData" TextChanged="txtData_TextChanged" Grid.Column="1" Grid.Row="2"  ></TextBox>
        <TextBox x:Name="txtEmail" TextChanged="txtEmail_TextChanged" Grid.Column="1" Grid.Row="3"  ></TextBox>
        <TextBox x:Name="txtNIF" TextChanged="txtNIF_TextChanged" Grid.Column="1" Grid.Row="4"  ></TextBox>

        <Label x:Name="lblNumero" Grid.Column="2" Grid.Row="0"  ></Label>
        <Label x:Name="lblPes" Grid.Column="2" Grid.Row="1" ></Label>
        <Label x:Name="lblData" Grid.Column="2" Grid.Row="2"></Label>
        <Label x:Name="lblEmail" Grid.Column="2" Grid.Row="3"></Label>
        <Label x:Name="lblNif" Grid.Column="2" Grid.Row="4"></Label>

    </Grid>
</Window>

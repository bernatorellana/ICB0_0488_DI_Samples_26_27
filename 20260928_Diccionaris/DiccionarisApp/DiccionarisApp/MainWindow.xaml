<Window x:Class="DiccionarisApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiccionarisApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Padding="20"
        Loaded="Window_Loaded">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="White"/>
            <GradientStop Color="#FFE8CECE" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Border Padding="10" BorderBrush="DarkGray" BorderThickness="1" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0">NIF</Label>
                    <TextBox x:Name="txtNIF" Grid.Row="0" Grid.Column="1"/>
                    <Label Grid.Row="1" Grid.Column="0">Nom</Label>
                    <TextBox x:Name="txtNom" Grid.Row="1" Grid.Column="1"/>
                    <Label Grid.Row="2" Grid.Column="0">Cognom</Label>
                    <TextBox x:Name="txtCognom" Grid.Row="2" Grid.Column="1"/>

                </Grid>
            </Border>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Click="btnCancel_Click" Grid.Column="0" HorizontalAlignment="Center">Cancel</Button>
                <Button x:Name="btnNew" Click="btnNew_Click" Grid.Column="1" HorizontalAlignment="Center">New</Button>
                <Button x:Name="btnSave" Click="btnSave_Click" Grid.Column="2" HorizontalAlignment="Center">Save</Button>
            </Grid>
        </StackPanel>
        <!--===================== COLUMNA 2 ============================ -->
        <StackPanel Grid.Column="1" VerticalAlignment="Stretch" >
            <Label>Persones</Label>
            <ListView Height="100" SelectionChanged="lsvPersones_SelectionChanged" 
                      x:Name="lsvPersones" VerticalAlignment="Stretch">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"></ColumnDefinition>
                                <ColumnDefinition Width="60"></ColumnDefinition>
                                <ColumnDefinition Width="60"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="{Binding NIF}"></Label>
                            <Label Grid.Column="1" Content="{Binding Nom}"></Label>
                            <Label Grid.Column="2" Content="{Binding Cognoms}"></Label>
                            
                        </Grid>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
                
            </ListView>
        </StackPanel>
        <!--===================== COLUMNA 3 ============================ -->
        <Button x:Name="btnMove" Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Margin="10" Content="&#xE970;"></Button>
        <!--===================== COLUMNA 4 ============================ -->
        <StackPanel Grid.Column="3" VerticalAlignment="Stretch" >
            <Label>Equip</Label>
            <ComboBox  x:Name="cboEquips" Margin="10"></ComboBox>
            <Label>Jugadors</Label>
            <ListView  x:Name="lsvJugadors" Margin="10" VerticalAlignment="Stretch" Background="red"></ListView>
        </StackPanel>
    </Grid>
</Window>

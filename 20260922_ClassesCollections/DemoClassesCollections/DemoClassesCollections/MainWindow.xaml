<Window x:Class="DemoClassesCollections.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoClassesCollections"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition  Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <ComboBox x:Name="cboVehicles" Margin="10"></ComboBox>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center"  >
            <Button x:Name="btnRight" Margin="10" Padding="10" FontFamily="Segoe MDL2 Assets" >&#xE72A;</Button>
            <Button x:Name="btnLeft"  Margin="10" Padding="10" FontFamily="Segoe MDL2 Assets" >&#xE72B;</Button>
        </StackPanel>

        <ListView x:Name="lsvSeleccionats" Grid.Column="2" Margin="10" Background="Aquamarine">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Background="red" Orientation="Horizontal">
                        <Label Content="{Binding Matricula}"></Label>
                        <Label Content="{Binding Model}"></Label>
                        <Label Content="{Binding Marca}"></Label>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            
        </ListView>
        
        <TextBox x:Name="txtSortida"
                 Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Margin="10"
                 ></TextBox>
    </Grid>
</Window>
